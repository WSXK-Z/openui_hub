{
  "include": ["src/**/*", "src/**/*.vue", "oui.d.ts"],
  "compilerOptions": {
    "paths": {
      "oui-hub:@oui/button": ["./oui-types/@oui/button/index"]
    },
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.oui.tsbuildinfo",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true
  }
}
