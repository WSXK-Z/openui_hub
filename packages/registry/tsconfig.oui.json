{
  "include": ["src/**/*.ts", "src/**/*.vue", "oui.d.ts"],
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": ".oui-hub/types",
    "strict": true,
    "composite": true,
    "tsBuildInfoFile": ".oui-hub/types/.tsbuildinfo",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true
  }
}
