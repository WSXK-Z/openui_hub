{
  "name": "@openui_hub/registry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "openui_hub 官方组件真源：样例组件构建为可发布包（manifest + dist）",
  "scripts": {
    "prebuild": "pnpm --filter @openui_hub/plugin_vite build",
    "build": "vue-tsc -p tsconfig.oui.json && vite build"
  },
  "devDependencies": {
    "@openui_hub/cli": "workspace:*",
    "@openui_hub/plugin_vite": "workspace:*"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}