{
  "name": "@dp_ui/core",
  "version": "0.1.0",
  "description": "基于 reka-ui + UnoCSS 的页面级 Vue 组件库（page → panel → component）",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/style.css",
    "**/*.css"
  ],
  "main": "./dist/core.cjs",
  "module": "./dist/core.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.cjs"
    },
    "./style.css": "./dist/style.css",
    "./unocss": {
      "types": "./dist/types/tokens/presetDpUi.d.ts",
      "import": "./dist/preset-core.mjs",
      "require": "./dist/preset-core.cjs"
    },
    "./page": {
      "types": "./dist/types/page/index.d.ts",
      "import": "./dist/page/index.mjs",
      "require": "./dist/page/index.cjs"
    },
    "./panel": {
      "types": "./dist/types/panel/index.d.ts",
      "import": "./dist/panel/index.mjs",
      "require": "./dist/panel/index.cjs"
    },
    "./components/*": {
      "types": "./dist/types/components/*/index.d.ts",
      "import": "./dist/components/*/index.mjs",
      "require": "./dist/components/*/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "type-check": "vue-tsc --build",
    "build:lib": "vite build --config build/build.lib.ts",
    "build:types": "vue-tsc -p tsconfig.build.json",
    "build:dist": "run-s clean:dist build:lib build:types",
    "prepublishOnly": "pnpm run build:dist",
    "clean:dist": "node -e \"import('node:fs').then(({rmSync}) => rmSync('dist', {recursive: true, force: true}))\"",
    "test:unit": "vitest run"
  },
  "dependencies": {},
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.13.3",
    "@unocss/preset-legacy-compat": "^66.7.5",
    "@unocss/preset-tagify": "^66.7.5",
    "@unocss/transformer-variant-group": "^66.7.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^26.0.0",
    "lint-staged": "^17.2.0",
    "npm-run-all2": "^9.0.2",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "reka-ui": "^2.10.1",
    "typescript": "^5.9.3",
    "unocss": "^66.7.5",
    "vite": "^8.1.5",
    "vitest": "^4.0.0",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.3.8"
  },
  "peerDependencies": {
    "reka-ui": "^2.0.0",
    "unocss": "^66.0.0",
    "vue": "^3.5.0",
    "vue-router": "^5.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "pnpm run lint",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}