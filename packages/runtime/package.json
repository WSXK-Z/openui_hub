{
  "name": "@openui_hub/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "openui_hub 运行时远程加载：loader + HubRemote Vue 组件",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/hub-runtime.mjs"
    }
  },
  "scripts": {
    "build": "vite build --config build/vite.lib.ts && tsc -p tsconfig.build.json",
