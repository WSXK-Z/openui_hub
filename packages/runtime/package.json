    "pretest:unit": "pnpm --filter @openui_hub/registry build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.0.0",
    "vue": "^3.5.40"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
