{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue"
  ],
  "exclude": [
    "src/**/__tests__/*"
  ],
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    // @dp_ui/schema 自身源码一律使用相对导入；下面的路径映射只用于解析
    // 被引用的 @dp_ui/core 源码（其内部使用 "@/..." 别名）：
    // - `@dp_ui/core` → @dp_ui/core 源码入口
    // - `@/*`         → @dp_ui/core 源码根（供其内部别名使用）
    "paths": {
      "@dp_ui/core": [
        "../core/src/index.ts"
      ],
      "@/*": [
        "../core/src/*"
      ]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  }
}