{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue"
  ],
  "exclude": [],
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    // 测试与库源码共用同一套路径映射（见 tsconfig.app.json 注释）
    "paths": {
      "@dp_ui/core": [
        "../core/src/index.ts"
      ],
      "@/*": [
        "../core/src/*"
      ]
    },
    "types": [
      "node"
    ],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo"
  }
}