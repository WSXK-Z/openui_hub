{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/WSXK-Z/openui_hub/main/packages/cli/oui.schema.json",
  "$comment": "oui.json：CLI 在当前目录的配置与公共默认值。组件清单见 oui.components.schema.json，使用锁定见 oui.lock.schema.json。",
  "description": "Configuration for the oui component publisher and consumer.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "description": "项目或组件的默认类型。",
      "default": "vue-component"
    },
    "cssStrategy": {
      "type": "string",
      "enum": [
        "vanilla",
        "atomic-unocss",
        "atomic-var"
      ],
      "default": "vanilla"
    },
    "lockFile": {
      "type": "string",
      "default": "oui.lock.json",
      "description": "使用锁定文件名（相对 oui.json），默认 oui.lock.json。"
    },
    "outDir": {
      "type": "string",
      "default": "pkg",
      "description": "构建产物根目录（相对 oui.json），默认 pkg。"
    },
    "uno": {
      "type": "boolean",
      "description": "组件源码是否使用 UnoCSS 原子类。"
    },
    "peer": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "默认 peer 依赖。"
    }
  }
}
