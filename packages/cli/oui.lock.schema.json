{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://raw.githubusercontent.com/WSXK-Z/openui_hub/main/packages/cli/oui.lock.schema.json",
    "$comment": "oui.lock.json：使用依赖锁定（组件使用者），由 `oui use` 写入；每个包记录一个 default 版本与若干已锁定版本，仅记来源 hub 地址，产物路径/样式/类型由该版本的 manifest 决定。",
    "type": "object",
    "additionalProperties": true,
    "properties": {
        "$schema": {
            "type": "string"
        },
        "packages": {
            "type": "object",
            "additionalProperties": {
                "$ref": "#/definitions/package"
            }
        }
    },
    "definitions": {
        "package": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "versions"
            ],
            "properties": {
                "default": {
                    "type": "string",
                    "description": "不带版本号的导入（oui-hub:<name>）指向的版本。"
                },
                "versions": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/definitions/version"
                    }
                }
            }
        },
        "version": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "registry": {
                    "type": "string",
                    "description": "该版本来源 hub 地址；产物 URL = <registry>/v/<name>@<version>/…。"
                }
            }
        }
    }
}