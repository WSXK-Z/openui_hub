{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://raw.githubusercontent.com/WSXK-Z/openui_hub/main/packages/cli/oui.lock.schema.json",
    "$comment": "oui.lock.json：使用依赖锁定（组件使用者），由 `oui use` 写入；每项只记录固定版本与来源 hub 地址，产物路径/样式/类型由该版本的 manifest 决定。",
    "type": "object",
    "additionalProperties": true,
    "properties": {
        "$schema": {
            "type": "string"
        },
        "packages": {
            "type": "object",
            "additionalProperties": {
                "$ref": "#/definitions/entry"
            }
        }
    },
    "definitions": {
        "entry": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "version"
            ],
            "properties": {
                "version": {
                    "type": "string"
                },
                "registry": {
                    "type": "string",
                    "description": "该包来源 hub 地址；产物 URL = <registry>/v/<name>@<version>/…。"
                }
            }
        }
    }
}
